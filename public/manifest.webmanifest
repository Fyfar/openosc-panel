{
  "name": "OpenOSC Panel",
  "short_name": "OpenOSC",
  "description": "Oscilloscope, signal generator, Bode plotter and multimeter for ZOYI ZT703S / ZT706S on OpenOSC firmware.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d1117",
